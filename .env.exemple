# === StencilForge Configuration ===

# Порт сервера
PORT=8080

# JWT-секрет (сгенерируйте случайную строку, например: openssl rand -hex 32)
JWT_SECRET=change_me

# Путь к директории с данными (SQLite БД)
# STENCILFORGE_DATA_DIR=/var/lib/stencilforge

# === ЮKassa (yookassa.ru) ===
# Идентификатор магазина (shopId)
YOOKASSA_SHOP_ID=your_shop_id_here

# Секретный ключ магазина
YOOKASSA_SECRET_KEY=your_secret_key_here

# URL возврата после оплаты
# YOOKASSA_RETURN_URL=http://localhost:8080/profile

# === Кластер (StencilForge Cluster) ===
# Режим: main (главная нода с БД и авторизацией) или worker (вычислительная нода)
# STENCILFORGE_CLUSTER_MODE=main

# Уникальный ID ноды (авто-генерируется, можно задать вручную)
# STENCILFORGE_NODE_ID=node-001

# URL этой ноды (для взаимодействия с другими нодами)
# STENCILFORGE_ADVERTISE_URL=http://127.0.0.1:8080

# URL главной ноды (только для worker)
# STENCILFORGE_MAIN_URL=http://127.0.0.1:8080

# Максимальное количество worker-нод (для main)
# STENCILFORGE_MAX_WORKERS=4

# Секретный ключ для межнодового обмена
# STENCILFORGE_CLUSTER_SECRET=change_me
